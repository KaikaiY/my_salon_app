<h1>施術者プロフィール一覧</h1>

<% if @therapist_profiles.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>施術者</th>
        <th>得意分野</th>
        <th>公開状態</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @therapist_profiles.each do |therapist_profile| %>
        <tr>
          <td><%= therapist_profile.user.name %></td>
          <td><%= therapist_profile.specialty %></td>
          <td class="status-cell">
            <span class="status-chip <%= therapist_profile.published? ? 'status-positive' : 'status-neutral' %>">
              <%= therapist_profile.published? ? '公開中' : '非公開' %>
            </span>
          </td>
          <td class="action-cell">
            <%= link_to '詳細', therapist_profile_path(therapist_profile), class: 'inline-action' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>まだ施術者プロフィールは登録されていません。</p>
    <p>施術者の自己紹介や得意分野を登録すると、利用者が施術者を把握しやすくなります。</p>
  </div>
<% end %>
