<%= form_with model: company, local: true do |f| %>
  <%= render 'shared/error_messages', model: f.object %>

  <div class="field">
    <p><%= f.label :company_name, "会社名" %></p>
    <p><%= f.text_field :company_name %></p>
  </div>

  <div class="field">
    <p><%= f.label :email, "メールアドレス" %></p>
    <p><%= f.text_field :email %></p>
  </div>

  <div class="field">
    <p><%= f.label :phone, "電話番号" %></p>
    <p><%= f.text_field :phone %></p>
  </div>

  <div class="actions">
    <%= f.submit "保存する" %>
  </div>
<% end %>
