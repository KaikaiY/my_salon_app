<h1>会社一覧</h1>
<div class="page-actions">
  <%= link_to '会社登録ページへ', new_company_path, class: "button-link company-record"%>
</div>
<% if @companies.any? %>
  <div class="company-contents">
    <ul class="company-lists">
      <% @companies.each do |company|%>
        <%= link_to company_path(company) do %>
          <li class="company-list">
            <div class="card-item">
              <p class="card-label">会社名</p>
              <p class="card-value"><%= company.company_name %></p>
            </div>
            <div class="card-item">
              <p class="card-label">メールアドレス</p>
              <p class="card-value"><%= company.email %></p>
            </div>
            <div class="card-item">
              <p class="card-label">電話番号</p>
              <p class="card-value"><%= company.phone %></p>
            </div>
            <p class="card-hint">クリックして詳細を表示</p>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class="empty-state">
    <p>まだ会社は登録されていません。</p>
    <p>会社登録ページから最初の会社を登録してください。</p>
  </div>
<% end %>
