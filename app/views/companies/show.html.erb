<h1>会社詳細</h1>
<%= link_to '会社一覧ページへ', companies_path %>
<div class="company-show">
  <div class="company-name">
    <span>会社名:<%= @company.company_name %></span>
  </div>
  <div class="company-email">
    <span>メールアドレス:<%= @company.email %></span>
    </div>
  <div class="company-phone">
    <span>電話番号:<%= @company.phone %></span>
  </div>
</div>