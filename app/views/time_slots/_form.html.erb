<%= form_with model: [@treatment_day, @time_slot] do |f| %>
  <% if @time_slot.errors.any? %>
    <div>
      <ul>
        <% @time_slot.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <p>施術日: <%= @treatment_day.date %></p>
  </div>

  <div>
    <p><%= f.label :start_time, "開始時刻" %></p>
    <p><%= f.time_field :start_time %></p>
  </div>

  <div>
    <p><%= f.label :end_time, "終了時刻" %></p>
    <p><%= f.time_field :end_time %></p>
  </div>

  <% if @time_slot.new_record? %>
    <div>
      <p>
        <%= check_box_tag "time_slot[bulk_create]", "1" %>
        <%= label_tag "time_slot_bulk_create", "20分ごとにまとめて作成する" %>
      </p>
      <p>例: 10:00〜11:00 を指定すると、10:00〜10:20 / 10:20〜10:40 / 10:40〜11:00 の3枠を作成します。</p>
    </div>
  <% end %>

  <div>
    <%= f.submit "保存する" %>
  </div>
<% end %>
