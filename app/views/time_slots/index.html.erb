<h1>予約可能枠一覧</h1>

<% if @time_slots.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>施術日</th>
        <th>会社</th>
        <th>担当施術者</th>
        <th>時間</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @time_slots.each do |time_slot| %>
        <tr>
          <td><%= time_slot.treatment_day.date %></td>
          <td><%= time_slot.treatment_day.company.company_name %></td>
          <td><%= time_slot.treatment_day.therapist&.name || "未割当" %></td>
          <td class="time-range">
            <%= time_slot.start_time.strftime("%H:%M") %>
            -
            <%= time_slot.end_time.strftime("%H:%M") %>
          </td>
          <td class="action-cell">
            <% if current_user.employee? %>
              <%= link_to "この時間を予約する", new_treatment_day_time_slot_reservation_path(time_slot.treatment_day, time_slot), class: "inline-action" %>
            <% else %>
              <%= link_to "施術日詳細", treatment_day_path(time_slot.treatment_day), class: "inline-action" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>表示できる時間枠はありません。</p>
    <% if current_user.employee? %>
      <p>予約可能な時間枠が公開されると、ここから予約に進めます。</p>
    <% else %>
      <p>施術日や時間枠が登録されると、ここに表示されます。</p>
    <% end %>
  </div>
<% end %>
