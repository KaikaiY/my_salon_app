<h2>招待一覧</h2>

<p><%= link_to "新しい招待を作成", new_invitation_path %></p>

<% if @invitations.any? %>
  <table>
    <thead>
      <tr>
        <th>メールアドレス</th>
        <th>会社</th>
        <th>権限</th>
        <th>状態</th>
        <th>招待URL</th>
        <th>承認</th>
      </tr>
    </thead>
    <tbody>
      <% @invitations.each do |invitation| %>
        <tr>
          <td><%= invitation.email %></td>
          <td><%= invitation.company&.company_name || "未設定" %></td>
          <td><%= invitation.human_role %></td>
          <td>
            <p><%= invitation.human_status %></p>
            <% if invitation.pending? %>
              <p>まだ登録申請されていません</p>
            <% elsif invitation.accepted? %>
              <p>管理者の承認待ちです</p>
            <% elsif invitation.approved? %>
              <p>ログイン可能です</p>
            <% elsif invitation.expired? %>
              <p>この招待URLは使用できません</p>
            <% end %>
          </td>
          <td>
            <%= new_user_registration_url(invitation_token: invitation.token) %>
            <button
              type="button"
              class="copy-invitation-url"
              data-url="<%= new_user_registration_url(invitation_token: invitation.token) %>">
              URLをコピー
            </button>
          </td>
          <td>
            <% if invitation.accepted? && invitation.user.present? %>
              <%= button_to "承認する", approve_invitation_path(invitation), method: :patch %>
            <% elsif invitation.approved? %>
              承認済みです
            <% elsif invitation.pending? %>
              登録申請待ちです
            <% elsif invitation.expired? %>
              承認できません
            <% else %>
              承認できません
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>まだ招待は作成されていません。</p>
  <p>新しい招待を作成して、対象ユーザーに登録URLを共有してください。</p>
<% end %>
