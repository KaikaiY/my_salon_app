<h2>招待一覧</h2>

<div class="page-actions">
  <%= link_to "新しい招待を作成", new_invitation_path, class: "button-link" %>
</div>

<% if @invitations.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>メールアドレス</th>
        <th>会社</th>
        <th>権限</th>
        <th>状態</th>
        <th>招待URL</th>
        <th>承認</th>
      </tr>
    </thead>
    <tbody>
      <% @invitations.each do |invitation| %>
        <tr>
          <td><%= invitation.email %></td>
          <td><%= invitation.company&.company_name || "未設定" %></td>
          <td class="role-cell"><%= invitation.human_role %></td>
          <td class="status-cell">
            <p class="status-label"><%= invitation.human_status %></p>
            <% if invitation.pending? %>
              <p class="status-note">未申請です</p>
            <% elsif invitation.accepted? %>
              <p class="status-note">承認待ちです</p>
            <% elsif invitation.approved? %>
              <p class="status-note">ログイン可能です</p>
            <% elsif invitation.expired? %>
              <p class="status-note">この招待URLは使用できません</p>
            <% end %>
          </td>
          <td class="url-cell">
            <p class="inline-code"><%= new_user_registration_url(invitation_token: invitation.token) %></p>
            <button
              type="button"
              class="copy-invitation-url"
              data-url="<%= new_user_registration_url(invitation_token: invitation.token) %>">
              URLをコピー
            </button>
          </td>
          <td class="action-cell approval-cell">
            <% if invitation.accepted? && invitation.user.present? %>
              <%= button_to "承認する", approve_invitation_path(invitation), method: :patch %>
            <% elsif invitation.approved? %>
              承認済みです
            <% elsif invitation.pending? %>
              申請待ちです
            <% elsif invitation.expired? %>
              承認できません
            <% else %>
              承認できません
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>まだ招待は作成されていません。</p>
    <p>新しい招待を作成して、対象ユーザーに登録URLを共有してください。</p>
  </div>
<% end %>
