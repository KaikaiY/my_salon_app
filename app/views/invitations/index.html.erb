<h2>招待一覧</h2>

<p><%= link_to "新しい招待を作成", new_invitation_path %></p>

<table>
  <thead>
    <tr>
      <th>メールアドレス</th>
      <th>会社</th>
      <th>権限</th>
      <th>状態</th>
      <th>招待URL</th>
      <th>承認</th>
    </tr>
  </thead>
  <tbody>
    <% @invitations.each do |invitation| %>
      <tr>
        <td><%= invitation.email %></td>
        <td><%= invitation.company.company_name %></td>
        <td><%= invitation.role %></td>
        <td><%= invitation.status %></td>
        <td><%= new_user_registration_url(invitation_token: invitation.token) %></td>
        <td>
          <% if invitation.accepted? && invitation.user.present? %>
            <%= button_to "承認する", approve_invitation_path(invitation), method: :patch %>
          <% elsif invitation.approved? %>
            承認済み
          <% else %>
            -
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
