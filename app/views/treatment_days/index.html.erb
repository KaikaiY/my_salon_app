<h1>施術日一覧</h1>

<div class="page-actions">
  <%= link_to "施術日登録ページへ", new_treatment_day_path, class: "button-link" %>
</div>

<% if @treatment_days.any? %>
  <div class="treatment-day-contents">
    <ul class="treatment-day-lists">
      <% @treatment_days.each do |treatment_day| %>
        <%= link_to treatment_day_path(treatment_day) do %>
          <li class="treatment-day-list">
            <div class="card-item">
              <p class="card-label">施術日</p>
              <p class="card-value"><%= treatment_day.date %></p>
            </div>
            <div class="card-item">
              <p class="card-label">会社</p>
              <p class="card-value"><%= treatment_day.company.company_name %></p>
            </div>
            <div class="card-item">
              <p class="card-label">担当施術者</p>
              <p class="card-value"><%= treatment_day.therapist&.name || "未割当" %></p>
            </div>
            <div class="card-item">
              <p class="card-label">予約受付元</p>
              <p class="card-value"><%= treatment_day.human_booking_source %></p>
            </div>
            <div class="card-item">
              <p class="card-label">ステータス</p>
              <p class="card-value"><%= treatment_day.human_status %></p>
            </div>
            <p class="card-hint">クリックして詳細を表示</p>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class="empty-state">
    <p>まだ施術日は登録されていません。</p>
    <p>施術日登録ページから新しい施術日を作成してください。</p>
  </div>
<% end %>
