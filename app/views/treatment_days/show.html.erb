<h1>施術日詳細</h1>

<div class="page-actions page-actions">
  <%= link_to "施術日一覧ページへ", treatment_days_path, class: "inline-action" %>
</div>

<section class="detail-card detail-card-centered">
  <div class="detail-list">
    <div class="detail-item">
      <p class="detail-label">施術日</p>
      <p class="detail-value"><%= @treatment_day.date %></p>
    </div>
    <div class="detail-item">
      <p class="detail-label">会社</p>
      <p class="detail-value"><%= @treatment_day.company.company_name %></p>
    </div>
    <div class="detail-item">
      <p class="detail-label">担当施術者</p>
      <p class="detail-value"><%= @treatment_day.therapist&.name || "未割当" %></p>
    </div>
    <div class="detail-item">
      <p class="detail-label">予約受付元</p>
      <p class="detail-value"><%= @treatment_day.human_booking_source %></p>
    </div>
    <div class="detail-item">
      <p class="detail-label">ステータス</p>
      <p class="detail-value"><span class="<%= status_label_classes(@treatment_day.status) %>"><%= @treatment_day.human_status %></span></p>
    </div>
    <div class="detail-item">
      <p class="detail-label">メモ</p>
      <p class="detail-value"><%= @treatment_day.note.presence || "なし" %></p>
    </div>
  </div>

  <div class="detail-actions">
    <%= link_to "施術日の編集", edit_treatment_day_path(@treatment_day), class: "inline-action" %>

    <% if @treatment_day.cancelled? %>
      <p class="detail-note">この施術日は中止されています。時間枠は履歴確認のため表示されています。</p>
      <%= link_to "施術日を再開する",
                  reopen_treatment_day_path(@treatment_day),
                  class: "inline-action",
                  data: {
                    turbo_method: :patch,
                    turbo_confirm: "この施術日を再開しますか？"
                  } %>
    <% else %>
      <%= link_to "施術日を中止する",
                  cancel_treatment_day_path(@treatment_day),
                  class: "inline-action danger-action",
                  data: {
                    turbo_method: :patch,
                    turbo_confirm: "この施術日を中止しますか？"
                  } %>

      <%= link_to "時間枠を追加する", new_treatment_day_time_slot_path(@treatment_day), class: "inline-action" %>
    <% end %>
  </div>
</section>

<h2>時間枠一覧</h2>

<% if @treatment_day.time_slots.any? %>
  <ul class="detail-sublist">
    <% @treatment_day.time_slots.each do |time_slot| %>
      <li class="detail-subitem">
        <span class="time-range"><%= time_slot.start_time.strftime("%H:%M") %> 〜 <%= time_slot.end_time.strftime("%H:%M") %></span>
        <% if @treatment_day.cancelled? %>
          <span class="status-chip status-negative">操作不可</span>
        <% else %>
          <%= link_to "編集", edit_treatment_day_time_slot_path(@treatment_day, time_slot), class: "inline-action" %>
        <% end %>

        <% if time_slot.reservations.exists? %>
          <span class="status-chip status-warning">予約履歴あり</span>
        <% elsif !@treatment_day.cancelled? %>
          <%= link_to "削除",
                      treatment_day_time_slot_path(@treatment_day, time_slot),
                      class: "inline-action danger-action",
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "この時間枠を削除しますか？"
                      } %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state detail-card-centered">
    <p>時間枠はまだ登録されていません。</p>
    <% unless @treatment_day.cancelled? %>
      <p>時間枠を追加すると、この施術日に予約できる時間を公開できます。</p>
    <% end %>
  </div>
<% end %>
