<section class="home-hero">
  <h2>サロンアプリへようこそ</h2>

  <% if user_signed_in? %>
    <p class="home-role-status">
      <span class="status-chip status-active"><%= current_user.human_role %></span>
      <span><%= current_user.name %>さんがログイン中です。</span>
    </p>
    <p class="home-intro">
      このページから、今の権限で利用できる主な操作に進めます。
    </p>

    <section class="home-menu">
      <% if current_user.admin? %>
        <%= render "admin_menu" %>
      <% elsif current_user.company_manager? %>
        <%= render "company_manager_menu" %>
      <% elsif current_user.therapist? %>
        <%= render "therapist_menu" %>
      <% elsif current_user.employee? %>
        <%= render "employee_menu" %>
      <% end %>
    </section>
  <% else %>
    <div class="empty-state">
      <p>ログインしていません。</p>
      <p>ログインすると、役割に応じたメニューや管理画面を利用できます。</p>
      <p><%= link_to "ログイン画面へ", new_user_session_path, class: "inline-action" %></p>
    </div>
  <% end %>
</section>
