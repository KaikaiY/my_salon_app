<p style="color: red;">サロンアプリへようこそ！！</p>
  <% if user_signed_in? %>
    <p>ログイン中です</p>
    <% if current_user.admin? %>
      <%= render "admin_menu" %>
    <% elsif current_user.company_manager? %>
      <%= render "company_manager_menu" %>
    <% elsif current_user.therapist? %>
      <%= render "therapist_menu" %>
    <% elsif current_user.employee? %>
      <%= render "employee_menu" %>
    <% end %>
  <% else %> 
    <p>ログインしていません</p>   
  <% end %> 
