<section class="auth-page">
  <div class="auth-card">
    <h2>新しいパスワード設定</h2>
    <div class="auth-description">
      <p>新しいパスワードを設定してください。</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <p><%= f.label :password, "新しいパスワード" %></p>
        <% if @minimum_password_length %>
          <p><em>（<%= @minimum_password_length %>文字以上で入力してください）</em></p>
        <% end %>
        <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password_confirmation, "新しいパスワード確認" %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
      </div>

      <div class="actions">
        <%= f.submit "パスワードを変更する" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
