<section class="auth-page">
  <div class="auth-card">
    <h2>アカウント編集</h2>
    <div class="auth-description">
      <p>メールアドレスやパスワードを更新できます。</p>
      <p>変更を保存するには現在のパスワードが必要です。</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <p><%= f.label :email, "メールアドレス" %></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="form-errors">
          <p>確認待ちのメールアドレス: <%= resource.unconfirmed_email %></p>
        </div>
      <% end %>

      <div class="field">
        <p><%= f.label :password, "新しいパスワード" %></p>
        <p><em>変更しない場合は空欄のままにしてください。</em></p>
        <p><%= f.password_field :password, autocomplete: "new-password" %></p>
        <% if @minimum_password_length %>
          <p><em><%= @minimum_password_length %>文字以上で入力してください</em></p>
        <% end %>
      </div>

      <div class="field">
        <p><%= f.label :password_confirmation, "新しいパスワード確認" %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
      </div>

      <div class="field">
        <p><%= f.label :current_password, "現在のパスワード" %></p>
        <p><em>変更内容を保存するために必要です。</em></p>
        <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
      </div>

      <div class="actions">
        <%= f.submit "更新する" %>
      </div>
    <% end %>

    <section class="detail-card">
      <h3>アカウント削除</h3>
      <p class="detail-note">アカウントを削除すると元に戻せません。</p>
      <div class="detail-actions">
        <%= button_to "アカウントを削除する",
                      registration_path(resource_name),
                      class: "danger-action",
                      data: { confirm: "本当に削除しますか？", turbo_confirm: "本当に削除しますか？" },
                      method: :delete %>
        <%= link_to "戻る", :back, class: "inline-action" %>
      </div>
    </section>
  </div>
</section>
