<section class="auth-page">
  <div class="auth-card">
    <h2>招待ユーザー登録</h2>

    <div class="auth-description">
      <p>この画面から登録申請を行います。</p>
      <p>登録申請後は、管理者の承認が完了するとログインできるようになります。</p>
      <p>メールアドレスは招待時に指定されたものから変更できません。</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.hidden_field :invitation_token, value: params[:invitation_token] || params.dig(:user, :invitation_token) %>

      <div class="field">
        <p><%= f.label :name, "名前" %></p>
        <p><%= f.text_field :name, autofocus: true, autocomplete: "name" %></p>
      </div>

      <div class="field">
        <p><%= f.label :email, "メールアドレス" %></p>
        <p><%= f.email_field :email, autocomplete: "email", value: resource.email, readonly: true %></p>
      </div>

      <div class="field">
        <p><%= f.label :password, "パスワード" %></p>
        <% if @minimum_password_length %>
          <p><em>（<%= @minimum_password_length %>文字以上で入力してください）</em></p>
        <% end %>
        <p><%= f.password_field :password, autocomplete: "new-password" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password_confirmation, "パスワード確認" %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
      </div>

      <div class="actions">
        <%= f.submit "登録申請する" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
