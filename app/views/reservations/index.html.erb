<h1>予約一覧</h1>

<% if @reservations.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>施術日</th>
        <th>時間</th>
        <th>会社</th>
        <th>担当施術者</th>
        <th>利用者</th>
        <th>ステータス</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |reservation| %>
        <tr>
          <td><%= reservation.time_slot.treatment_day.date %></td>
          <td class="time-range">
            <%= reservation.time_slot.start_time.strftime("%H:%M") %>
            -
            <%= reservation.time_slot.end_time.strftime("%H:%M") %>
          </td>
          <td><%= reservation.time_slot.treatment_day.company.company_name %></td>
          <td><%= reservation.time_slot.treatment_day.therapist&.name || "未割当" %></td>
          <td><%= reservation.user.name %></td>
          <td class="status-cell"><span class="status-chip"><%= reservation.human_status %></span></td>
          <td class="action-cell">
            <%= link_to "詳細", reservation_path(reservation), class: "inline-action" %>
            <% if reservation.reserved? %>
              <%= link_to "キャンセルする",
                          cancel_reservation_path(reservation),
                          class: "inline-action danger-action",
                          data: {
                            turbo_method: :patch,
                            turbo_confirm: "この予約をキャンセルしますか？"
                          } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>表示できる予約はまだありません。</p>
  </div>
<% end %>
