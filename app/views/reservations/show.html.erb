<h1>予約詳細</h1>

<p>施術日: <%= @reservation.time_slot.treatment_day.date %></p>
<p>
  時間:
  <%= @reservation.time_slot.start_time.strftime("%H:%M") %>
  -
  <%= @reservation.time_slot.end_time.strftime("%H:%M") %>
</p>
<p>利用者: <%= @reservation.user.name %></p>
<p>ステータス: <%= @reservation.status %></p>
<p>メモ: <%= @reservation.note.presence || "なし" %></p>

<p><%= link_to "予約一覧へ戻る", reservations_path %></p>
