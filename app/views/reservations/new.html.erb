<section class="business-form-page">
  <div class="business-form-card">
    <div class="page-actions page-actions-left">
      <%= link_to "予約一覧へ戻る", reservations_path, class: "inline-action" %>
    </div>

    <h1>予約作成</h1>
    <div class="business-form-intro">
      <p>施術日: <%= @treatment_day.date %></p>
      <p>
        時間:
        <%= @time_slot.start_time.strftime("%H:%M") %>
        -
        <%= @time_slot.end_time.strftime("%H:%M") %>
      </p>
    </div>

    <%= form_with model: [@treatment_day, @time_slot, @reservation] do |f| %>
      <% if @reservation.errors.any? %>
        <div class="form-errors">
          <p><%= @reservation.errors.count %>件のエラーがあります。</p>
          <ul>
            <% @reservation.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <p><%= f.label :note, "メモ" %></p>
        <p><%= f.text_area :note %></p>
      </div>

      <div class="actions">
        <%= f.submit "予約する" %>
      </div>
    <% end %>
  </div>
</section>
